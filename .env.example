# Default local runtime: the upload flow works and is explicitly marked as a preview.
MODEL_MODE=preview

# The project ships with a reproducible Python 3.10 virtual environment recipe
# for the upstream GFPGAN runtime. Switch this after the official weight has
# been downloaded to models/GFPGANv1.4.pth.
# MODEL_MODE=gfpgan
# GFPGAN_MODEL_PATH=./models/GFPGANv1.4.pth
# GFPGAN_DEVICE=cpu

# Comma-separated browser origins allowed to call the local API.
# Add a trusted origin here only when you intentionally host the frontend.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
